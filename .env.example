# Canonical public origin. Drives metadataBase, canonical URLs, Open Graph
# tags, sitemap.xml and robots.txt. No trailing slash.
# Dev default is port 3001 because the NestJS backend owns port 3000.
NEXT_PUBLIC_SITE_URL="http://localhost:3001"

# Set once the iOS app is live. While unset, the hero and footer render a
# disabled "Coming soon to App Store" badge instead of a broken link.
# NEXT_PUBLIC_APP_STORE_URL="https://apps.apple.com/app/id0000000000"
